<UserControl x:Class="VideoPlayerPro.Controls.TriangleSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="90"
             Height="24">

    <UserControl.Resources>
        <Style x:Key="RevealButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoverButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="#EEEEEE"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Polygon Points="0,1 1,2 1,0" Fill="Black" Stretch="Fill"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.OpacityMask>

            <Rectangle x:Name="GradientBackground"/>

            <Slider Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="{Binding Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}" IsMoveToPointEnabled="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Slider.Template>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource RevealButton}"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LineThumb}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource CoverButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>
        </Grid>

        <Polygon Points="0,1 1,2 1,0" Stretch="Fill" Stroke="Transparent" StrokeThickness="0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>