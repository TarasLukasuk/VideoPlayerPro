<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\Themes\**" />
    <Compile Remove="Validators\**" />
    <EmbeddedResource Remove="Resources\Themes\**" />
    <EmbeddedResource Remove="Validators\**" />
    <None Remove="Resources\Themes\**" />
    <None Remove="Validators\**" />
    <Page Remove="Resources\Themes\**" />
    <Page Remove="Validators\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

</Project>
